# client-specific know-how stays local (redeveloped as custom instructions)
custom_instructions/
examples/otools/
examples/otools.meta
examples/meshvary/
PLAN_OTOOLS.md
PLAN_OTOOLS.md.meta

# only simpack_template ships in git as the "how to write a plugin"
# example; real domain plugins are local-only (own IP or client-specific)
plugins/polytess_hpc/
plugins/polytess_doe/
plugins/polytess_meshvary/

